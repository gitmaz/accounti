{
  "name": "accounti",
  "version": "0.1.0",
  "description": "Accounti — Australian company books (AWS CDK, React)",
  "private": true,
  "engines": { "node": ">=20.0.0" },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "cdk": "cdk",
    "synth": "cdk synth",
    "deploy": "cdk deploy --all",
    "test": "tsc -p tsconfig.api.json --noEmit && vitest run",
    "spa:dev": "npm --prefix spa run dev",
    "spa:build": "npm --prefix spa run build",
    "api:dev": "tsx server/local.ts",
    "dev": "node scripts/dev.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.787.0",
    "@aws-sdk/client-sesv2": "^3.1146.0",
    "@aws-sdk/lib-dynamodb": "^3.787.0",
    "aws-cdk-lib": "^2.170.0",
    "constructs": "^10.4.2",
    "nodemailer": "^7.0.6",
    "source-map-support": "^0.5.21"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.145",
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^6.4.17",
    "aws-cdk": "^2.1121.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.3",
    "typescript": "^5.6.0",
    "vitest": "^3.2.4"
  }
}
